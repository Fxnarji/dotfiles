/*
 * Generated by matugen.
 * Material You palette aliased to the legacy color0-9 names used
 * throughout the rofi configs.
 */
* {
    background:  {{ colors.surface.default.hex }};
    foreground:  {{ colors.on_surface.default.hex }};

    color0:  {{ colors.surface.default.hex }};
    color1:  {{ colors.secondary_container.default.hex }};
    color2:  {{ colors.error.default.hex }};
    color3:  {{ colors.secondary.default.hex }};
    color4:  {{ colors.primary_container.default.hex }};
    color5:  {{ colors.tertiary.default.hex }};
    color6:  {{ colors.primary.default.hex }};
    color7:  {{ colors.on_surface.default.hex }};
    color8:  {{ colors.outline.default.hex }};
    color9:  {{ colors.secondary_container.default.hex }};

    color0-transparent:  {{ colors.surface.default.hex }}cc;
    color1-transparent:  {{ colors.secondary_container.default.hex }}cc;
    color2-transparent:  {{ colors.error.default.hex }}cc;
    color3-transparent:  {{ colors.secondary.default.hex }}cc;
    color4-transparent:  {{ colors.primary_container.default.hex }}cc;
    color5-transparent:  {{ colors.tertiary.default.hex }}cc;
    color6-transparent:  {{ colors.primary.default.hex }}cc;
    color7-transparent:  {{ colors.on_surface.default.hex }}cc;
    color8-transparent:  {{ colors.outline.default.hex }}cc;
    color9-transparent:  {{ colors.secondary_container.default.hex }}cc;
}
